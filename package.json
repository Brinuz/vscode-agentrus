{
  "name": "agentrus",
  "displayName": "Agent\"R\"Us",
  "description": "Organize Claude Code work into initiatives, each with its own git worktree and a pinned set of agents.",
  "version": "0.0.6",
  "publisher": "bmonteiro",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brinuz/vscode-agentrus.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentrus",
          "title": "Agent\"R\"Us",
          "icon": "resources/agentrus.svg"
        }
      ]
    },
    "views": {
      "agentrus": [
        {
          "id": "agentrus.initiatives",
          "name": "Initiatives",
          "icon": "resources/agentrus.svg",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentrus.createInitiative",
        "title": "Create Initiative",
        "category": "Agent\"R\"Us",
        "icon": "$(add)"
      },
      {
        "command": "agentrus.refresh",
        "title": "Refresh",
        "category": "Agent\"R\"Us",
        "icon": "$(refresh)"
      },
      {
        "command": "agentrus.openAgent",
        "title": "Open Agent Session",
        "category": "Agent\"R\"Us"
      },
      {
        "command": "agentrus.openAllAgents",
        "title": "Open All Agents",
        "category": "Agent\"R\"Us",
        "icon": "$(run-all)"
      },
      {
        "command": "agentrus.openWorktreeWindow",
        "title": "Open Worktree in New Window",
        "category": "Agent\"R\"Us",
        "icon": "$(empty-window)"
      },
      {
        "command": "agentrus.openWorktreeHere",
        "title": "Open Worktree in This Window",
        "category": "Agent\"R\"Us",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "agentrus.removeInitiative",
        "title": "Remove Initiative",
        "category": "Agent\"R\"Us",
        "icon": "$(trash)"
      },
      {
        "command": "agentrus.removeInitiatives",
        "title": "Remove Initiatives…",
        "category": "Agent\"R\"Us",
        "icon": "$(trash)"
      },
      {
        "command": "agentrus.changeModel",
        "title": "Change Agent Model",
        "category": "Agent\"R\"Us"
      },
      {
        "command": "agentrus.configureInitiative",
        "title": "Configure Initiative",
        "category": "Agent\"R\"Us",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentrus.configureAgent",
        "title": "Configure Agent",
        "category": "Agent\"R\"Us",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentrus.configureShell",
        "title": "Configure Shell",
        "category": "Agent\"R\"Us",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentrus.addAgent",
        "title": "Add Agent",
        "category": "Agent\"R\"Us",
        "icon": "$(person-add)"
      },
      {
        "command": "agentrus.removeAgent",
        "title": "Remove Agent",
        "category": "Agent\"R\"Us",
        "icon": "$(trash)"
      },
      {
        "command": "agentrus.moveInitiativeUp",
        "title": "Move Initiative Up",
        "category": "Agent\"R\"Us",
        "icon": "$(arrow-up)"
      },
      {
        "command": "agentrus.moveInitiativeDown",
        "title": "Move Initiative Down",
        "category": "Agent\"R\"Us",
        "icon": "$(arrow-down)"
      },
      {
        "command": "agentrus.openSettings",
        "title": "Open Settings",
        "category": "Agent\"R\"Us",
        "icon": "$(gear)"
      },
      {
        "command": "agentrus.resetSession",
        "title": "Start Fresh Session",
        "category": "Agent\"R\"Us",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentrus.changeSkill",
        "title": "Change Startup Skill",
        "category": "Agent\"R\"Us",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentrus.newShell",
        "title": "New Shell",
        "category": "Agent\"R\"Us",
        "icon": "$(add)"
      },
      {
        "command": "agentrus.openShell",
        "title": "Open Shell",
        "category": "Agent\"R\"Us"
      },
      {
        "command": "agentrus.renameShell",
        "title": "Rename Shell",
        "category": "Agent\"R\"Us",
        "icon": "$(edit)"
      },
      {
        "command": "agentrus.addDefaultShells",
        "title": "Add Default Shells",
        "category": "Agent\"R\"Us",
        "icon": "$(list-unordered)"
      },
      {
        "command": "agentrus.removeShell",
        "title": "Remove Shell",
        "category": "Agent\"R\"Us",
        "icon": "$(trash)"
      },
      {
        "command": "agentrus.addDoc",
        "title": "Add Doc",
        "category": "Agent\"R\"Us",
        "icon": "$(add)"
      },
      {
        "command": "agentrus.removeDoc",
        "title": "Remove Doc from Initiative",
        "category": "Agent\"R\"Us",
        "icon": "$(close)"
      },
      {
        "command": "agentrus.revealDocsFolder",
        "title": "Reveal Docs Folder",
        "category": "Agent\"R\"Us",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentrus.copyArchivePath",
        "title": "Copy Archive Path",
        "category": "Agent\"R\"Us"
      },
      {
        "command": "agentrus.openArchivedDocs",
        "title": "Open Archived Docs",
        "category": "Agent\"R\"Us"
      },
      {
        "command": "agentrus.openDoc",
        "title": "Open Doc",
        "category": "Agent\"R\"Us"
      },
      {
        "command": "agentrus.revealDoc",
        "title": "Reveal Doc in Finder",
        "category": "Agent\"R\"Us",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentrus.deleteDocFile",
        "title": "Delete Doc File",
        "category": "Agent\"R\"Us",
        "icon": "$(trash)"
      },
      {
        "command": "agentrus.revealDocSubfolder",
        "title": "Reveal Folder in Finder",
        "category": "Agent\"R\"Us",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentrus.deleteDocSubfolder",
        "title": "Delete Folder",
        "category": "Agent\"R\"Us",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentrus.createInitiative",
          "when": "view == agentrus.initiatives",
          "group": "navigation@1"
        },
        {
          "command": "agentrus.refresh",
          "when": "view == agentrus.initiatives",
          "group": "navigation@2"
        },
        {
          "command": "agentrus.removeInitiatives",
          "when": "view == agentrus.initiatives",
          "group": "1_initiatives@1"
        },
        {
          "command": "agentrus.openArchivedDocs",
          "when": "view == agentrus.initiatives",
          "group": "2_archive@1"
        },
        {
          "command": "agentrus.copyArchivePath",
          "when": "view == agentrus.initiatives",
          "group": "2_archive@2"
        },
        {
          "command": "agentrus.openSettings",
          "when": "view == agentrus.initiatives",
          "group": "3_settings@1"
        }
      ],
      "webview/context": [
        {
          "command": "agentrus.openAllAgents",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "0_open@1"
        },
        {
          "command": "agentrus.openWorktreeHere",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "0_open@2"
        },
        {
          "command": "agentrus.openWorktreeWindow",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "0_open@3"
        },
        {
          "command": "agentrus.addAgent",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "1_add@1"
        },
        {
          "command": "agentrus.newShell",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "1_add@2"
        },
        {
          "command": "agentrus.addDoc",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "1_add@3"
        },
        {
          "command": "agentrus.revealDocsFolder",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "1_add@4"
        },
        {
          "command": "agentrus.moveInitiativeUp",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "2_order@1"
        },
        {
          "command": "agentrus.moveInitiativeDown",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "2_order@2"
        },
        {
          "command": "agentrus.removeInitiative",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'initiative'",
          "group": "3_modify@1"
        },
        {
          "command": "agentrus.openAllAgents",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'agents-group'",
          "group": "0_open@1"
        },
        {
          "command": "agentrus.addAgent",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'agents-group'",
          "group": "1_add@1"
        },
        {
          "command": "agentrus.addDoc",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'docs-group'",
          "group": "1_add@1"
        },
        {
          "command": "agentrus.revealDocsFolder",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'docs-group'",
          "group": "1_add@2"
        },
        {
          "command": "agentrus.newShell",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'shells-group'",
          "group": "1_add@1"
        },
        {
          "command": "agentrus.addDefaultShells",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'shells-group'",
          "group": "1_add@2"
        },
        {
          "command": "agentrus.changeModel",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'agent'",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.changeSkill",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'agent'",
          "group": "1_modify@2"
        },
        {
          "command": "agentrus.resetSession",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'agent'",
          "group": "1_modify@3"
        },
        {
          "command": "agentrus.removeAgent",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'agent' && agentrusCustom",
          "group": "2_remove@1"
        },
        {
          "command": "agentrus.renameShell",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'shell'",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.removeShell",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'shell'",
          "group": "2_remove@1"
        },
        {
          "command": "agentrus.revealDoc",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'doc'",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.revealDoc",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'doc-file'",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.deleteDocFile",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'doc-file'",
          "group": "2_remove@1"
        },
        {
          "command": "agentrus.revealDocSubfolder",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'doc-folder'",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.deleteDocSubfolder",
          "when": "webviewId == 'agentrus.initiatives' && webviewSection == 'doc-folder'",
          "group": "2_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentrus.openAgent",
          "when": "false"
        },
        {
          "command": "agentrus.openAllAgents",
          "when": "false"
        },
        {
          "command": "agentrus.openWorktreeWindow",
          "when": "false"
        },
        {
          "command": "agentrus.openWorktreeHere",
          "when": "false"
        },
        {
          "command": "agentrus.removeInitiative",
          "when": "false"
        },
        {
          "command": "agentrus.changeModel",
          "when": "false"
        },
        {
          "command": "agentrus.resetSession",
          "when": "false"
        },
        {
          "command": "agentrus.changeSkill",
          "when": "false"
        },
        {
          "command": "agentrus.newShell",
          "when": "false"
        },
        {
          "command": "agentrus.openShell",
          "when": "false"
        },
        {
          "command": "agentrus.removeShell",
          "when": "false"
        },
        {
          "command": "agentrus.addDoc",
          "when": "false"
        },
        {
          "command": "agentrus.removeDoc",
          "when": "false"
        },
        {
          "command": "agentrus.revealDocsFolder",
          "when": "false"
        },
        {
          "command": "agentrus.configureInitiative",
          "when": "false"
        },
        {
          "command": "agentrus.configureAgent",
          "when": "false"
        },
        {
          "command": "agentrus.configureShell",
          "when": "false"
        },
        {
          "command": "agentrus.addAgent",
          "when": "false"
        },
        {
          "command": "agentrus.removeAgent",
          "when": "false"
        },
        {
          "command": "agentrus.renameShell",
          "when": "false"
        },
        {
          "command": "agentrus.addDefaultShells",
          "when": "false"
        },
        {
          "command": "agentrus.moveInitiativeUp",
          "when": "false"
        },
        {
          "command": "agentrus.moveInitiativeDown",
          "when": "false"
        },
        {
          "command": "agentrus.openDoc",
          "when": "false"
        },
        {
          "command": "agentrus.revealDoc",
          "when": "false"
        },
        {
          "command": "agentrus.deleteDocFile",
          "when": "false"
        },
        {
          "command": "agentrus.revealDocSubfolder",
          "when": "false"
        },
        {
          "command": "agentrus.deleteDocSubfolder",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent\"R\"Us",
      "properties": {
        "agentrus.models.orchestrator": {
          "type": "string",
          "default": "opus",
          "description": "Model alias used for new orchestrator agents — the conversation you drive an initiative from."
        },
        "agentrus.models.architect": {
          "type": "string",
          "default": "opus",
          "description": "Model alias used for new architect agents."
        },
        "agentrus.models.dev": {
          "type": "string",
          "default": "opus",
          "description": "Model alias used for new dev agents."
        },
        "agentrus.models.reviewer": {
          "type": "string",
          "default": "opus",
          "description": "Model alias used for new reviewer agents."
        },
        "agentrus.models.qa": {
          "type": "string",
          "default": "opus",
          "description": "Model alias used for new QA agents."
        },
        "agentrus.models.generic": {
          "type": "string",
          "default": "opus",
          "description": "Model alias used for new generic agents — the little helper for questions and odd jobs."
        },
        "agentrus.skills.orchestrator": {
          "type": "string",
          "default": "",
          "description": "Skill new orchestrator agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.skills.architect": {
          "type": "string",
          "default": "",
          "description": "Skill new architect agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.skills.dev": {
          "type": "string",
          "default": "",
          "description": "Skill new dev agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.skills.reviewer": {
          "type": "string",
          "default": "",
          "description": "Skill new reviewer agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.skills.qa": {
          "type": "string",
          "default": "",
          "description": "Skill new QA agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.skills.generic": {
          "type": "string",
          "default": "",
          "description": "Skill new generic agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.defaultShells": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Shells every new initiative starts with, e.g. [\"dev\", \"logs\"]. They are listed in the tree but not opened until clicked. Use \"Add Default Shells\" on an existing initiative's Shells group to backfill."
        },
        "agentrus.terminalLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "enumDescriptions": [
            "Open terminals in the panel, alongside the other terminals.",
            "Open terminals as editor tabs, so they can be split and arranged like files."
          ],
          "default": "panel",
          "description": "Where Agent\"R\"Us opens terminals for agents and shells. Takes effect on the next terminal."
        },
        "agentrus.activityPollSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "How often to check the transcript of an open agent that has no hook state, to tell working from idle. 0 disables the fallback; hook-backed agents keep reporting either way."
        },
        "agentrus.worktreeRoot": {
          "type": "string",
          "default": "",
          "description": "Directory that holds initiative worktrees. Relative paths resolve against the repository root. Defaults to a sibling folder named '<repo>-worktrees'."
        },
        "agentrus.copyToWorktree": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env"
          ],
          "description": "Files copied from the repository into each newly created worktree, relative to the repo root — untracked config like .env does not travel with `git worktree add`. Prefix an entry with **/ to copy every file with that name found anywhere in the repo (outside .git and node_modules)."
        },
        "agentrus.branchPrefix": {
          "type": "string",
          "default": "initiative/",
          "description": "Prefix applied to the branch created for each initiative."
        },
        "agentrus.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to launch Claude Code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
