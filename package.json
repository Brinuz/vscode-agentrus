{
  "name": "agentrus",
  "displayName": "Agent\"R\"Us",
  "description": "Organize Claude Code work into initiatives, each with its own git worktree and a pinned set of agents.",
  "version": "0.0.6",
  "publisher": "bmonteiro",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentrus",
          "title": "Agent\"R\"Us",
          "icon": "resources/agentrus.svg"
        }
      ]
    },
    "views": {
      "agentrus": [
        {
          "id": "agentrus.initiatives",
          "name": "Initiatives",
          "icon": "resources/agentrus.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentrus.initiatives",
        "contents": "No initiatives yet.\n\nAn initiative is a git worktree on its own branch, with an architect, a dev, a reviewer and a generic agent pinned to it.\n[Create initiative](command:agentrus.createInitiative)",
        "when": "agentrus.hasRepo"
      },
      {
        "view": "agentrus.initiatives",
        "contents": "Agent\"R\"Us needs an open folder that is a git repository.\n[Open folder](command:vscode.openFolder)",
        "when": "!agentrus.hasRepo"
      }
    ],
    "commands": [
      {
        "command": "agentrus.createInitiative",
        "title": "Agent\"R\"Us: Create Initiative",
        "icon": "$(add)"
      },
      {
        "command": "agentrus.refresh",
        "title": "Agent\"R\"Us: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentrus.openAgent",
        "title": "Agent\"R\"Us: Open Agent Session"
      },
      {
        "command": "agentrus.openAllAgents",
        "title": "Agent\"R\"Us: Open All Agents",
        "icon": "$(run-all)"
      },
      {
        "command": "agentrus.openWorktreeWindow",
        "title": "Agent\"R\"Us: Open Worktree in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "agentrus.openWorktreeHere",
        "title": "Agent\"R\"Us: Open Worktree in This Window",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "agentrus.removeInitiative",
        "title": "Agent\"R\"Us: Remove Initiative",
        "icon": "$(trash)"
      },
      {
        "command": "agentrus.changeModel",
        "title": "Agent\"R\"Us: Change Agent Model"
      },
      {
        "command": "agentrus.configureInitiative",
        "title": "Agent\"R\"Us: Configure Initiative",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentrus.configureAgent",
        "title": "Agent\"R\"Us: Configure Agent",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentrus.configureShell",
        "title": "Agent\"R\"Us: Configure Shell",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentrus.addAgent",
        "title": "Agent\"R\"Us: Add Agent",
        "icon": "$(person-add)"
      },
      {
        "command": "agentrus.removeAgent",
        "title": "Agent\"R\"Us: Remove Agent",
        "icon": "$(trash)"
      },
      {
        "command": "agentrus.moveInitiativeUp",
        "title": "Agent\"R\"Us: Move Initiative Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "agentrus.moveInitiativeDown",
        "title": "Agent\"R\"Us: Move Initiative Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "agentrus.openSettings",
        "title": "Agent\"R\"Us: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "agentrus.resetSession",
        "title": "Agent\"R\"Us: Start Fresh Session",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentrus.changeSkill",
        "title": "Agent\"R\"Us: Change Startup Skill",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentrus.newShell",
        "title": "Agent\"R\"Us: New Shell",
        "icon": "$(add)"
      },
      {
        "command": "agentrus.openShell",
        "title": "Agent\"R\"Us: Open Shell"
      },
      {
        "command": "agentrus.renameShell",
        "title": "Agent\"R\"Us: Rename Shell",
        "icon": "$(edit)"
      },
      {
        "command": "agentrus.addDefaultShells",
        "title": "Agent\"R\"Us: Add Default Shells",
        "icon": "$(list-unordered)"
      },
      {
        "command": "agentrus.removeShell",
        "title": "Agent\"R\"Us: Remove Shell",
        "icon": "$(trash)"
      },
      {
        "command": "agentrus.addDoc",
        "title": "Agent\"R\"Us: Add Doc",
        "icon": "$(add)"
      },
      {
        "command": "agentrus.removeDoc",
        "title": "Agent\"R\"Us: Remove Doc from Initiative",
        "icon": "$(close)"
      },
      {
        "command": "agentrus.revealDocsFolder",
        "title": "Agent\"R\"Us: Reveal Docs Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentrus.revealDoc",
        "title": "Agent\"R\"Us: Reveal Doc in Finder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentrus.deleteDocFile",
        "title": "Agent\"R\"Us: Delete Doc File",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentrus.createInitiative",
          "when": "view == agentrus.initiatives",
          "group": "navigation@1"
        },
        {
          "command": "agentrus.refresh",
          "when": "view == agentrus.initiatives",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentrus.openAllAgents",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "inline@1"
        },
        {
          "command": "agentrus.configureInitiative",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "inline@2"
        },
        {
          "command": "agentrus.openAllAgents",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "0_open@1"
        },
        {
          "command": "agentrus.openWorktreeHere",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "0_open@2"
        },
        {
          "command": "agentrus.openWorktreeWindow",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "0_open@3"
        },
        {
          "command": "agentrus.addAgent",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "1_add@1"
        },
        {
          "command": "agentrus.newShell",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "1_add@2"
        },
        {
          "command": "agentrus.addDoc",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "1_add@3"
        },
        {
          "command": "agentrus.revealDocsFolder",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "1_add@4"
        },
        {
          "command": "agentrus.moveInitiativeUp",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "2_order@1"
        },
        {
          "command": "agentrus.moveInitiativeDown",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "2_order@2"
        },
        {
          "command": "agentrus.removeInitiative",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "3_modify@1"
        },
        {
          "command": "agentrus.openSettings",
          "when": "view == agentrus.initiatives && viewItem == initiative",
          "group": "4_settings@1"
        },
        {
          "command": "agentrus.openAllAgents",
          "when": "view == agentrus.initiatives && viewItem == group:agents",
          "group": "inline@1"
        },
        {
          "command": "agentrus.addAgent",
          "when": "view == agentrus.initiatives && viewItem == group:agents",
          "group": "inline@2"
        },
        {
          "command": "agentrus.openAllAgents",
          "when": "view == agentrus.initiatives && viewItem == group:agents",
          "group": "0_open@1"
        },
        {
          "command": "agentrus.addAgent",
          "when": "view == agentrus.initiatives && viewItem == group:agents",
          "group": "1_add@1"
        },
        {
          "command": "agentrus.addDoc",
          "when": "view == agentrus.initiatives && viewItem == group:docs",
          "group": "inline@1"
        },
        {
          "command": "agentrus.revealDocsFolder",
          "when": "view == agentrus.initiatives && viewItem == group:docs",
          "group": "inline@2"
        },
        {
          "command": "agentrus.addDoc",
          "when": "view == agentrus.initiatives && viewItem == group:docs",
          "group": "1_add@1"
        },
        {
          "command": "agentrus.revealDocsFolder",
          "when": "view == agentrus.initiatives && viewItem == group:docs",
          "group": "1_add@2"
        },
        {
          "command": "agentrus.newShell",
          "when": "view == agentrus.initiatives && viewItem == group:shells",
          "group": "inline@1"
        },
        {
          "command": "agentrus.newShell",
          "when": "view == agentrus.initiatives && viewItem == group:shells",
          "group": "1_add@1"
        },
        {
          "command": "agentrus.addDefaultShells",
          "when": "view == agentrus.initiatives && viewItem == group:shells",
          "group": "1_add@2"
        },
        {
          "command": "agentrus.configureAgent",
          "when": "view == agentrus.initiatives && viewItem =~ /^agent/",
          "group": "inline@1"
        },
        {
          "command": "agentrus.changeModel",
          "when": "view == agentrus.initiatives && viewItem =~ /^agent/",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.changeSkill",
          "when": "view == agentrus.initiatives && viewItem =~ /^agent/",
          "group": "1_modify@2"
        },
        {
          "command": "agentrus.resetSession",
          "when": "view == agentrus.initiatives && viewItem =~ /^agent/",
          "group": "1_modify@3"
        },
        {
          "command": "agentrus.removeAgent",
          "when": "view == agentrus.initiatives && viewItem == agent-custom",
          "group": "2_remove@1"
        },
        {
          "command": "agentrus.configureShell",
          "when": "view == agentrus.initiatives && viewItem == shell",
          "group": "inline@1"
        },
        {
          "command": "agentrus.renameShell",
          "when": "view == agentrus.initiatives && viewItem == shell",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.removeShell",
          "when": "view == agentrus.initiatives && viewItem == shell",
          "group": "2_remove@1"
        },
        {
          "command": "agentrus.removeDoc",
          "when": "view == agentrus.initiatives && viewItem == doc",
          "group": "inline@1"
        },
        {
          "command": "agentrus.revealDoc",
          "when": "view == agentrus.initiatives && viewItem == doc",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.revealDoc",
          "when": "view == agentrus.initiatives && viewItem == doc-file",
          "group": "1_modify@1"
        },
        {
          "command": "agentrus.deleteDocFile",
          "when": "view == agentrus.initiatives && viewItem == doc-file",
          "group": "2_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentrus.openAgent",
          "when": "false"
        },
        {
          "command": "agentrus.openAllAgents",
          "when": "false"
        },
        {
          "command": "agentrus.openWorktreeWindow",
          "when": "false"
        },
        {
          "command": "agentrus.openWorktreeHere",
          "when": "false"
        },
        {
          "command": "agentrus.removeInitiative",
          "when": "false"
        },
        {
          "command": "agentrus.changeModel",
          "when": "false"
        },
        {
          "command": "agentrus.resetSession",
          "when": "false"
        },
        {
          "command": "agentrus.changeSkill",
          "when": "false"
        },
        {
          "command": "agentrus.newShell",
          "when": "false"
        },
        {
          "command": "agentrus.openShell",
          "when": "false"
        },
        {
          "command": "agentrus.removeShell",
          "when": "false"
        },
        {
          "command": "agentrus.addDoc",
          "when": "false"
        },
        {
          "command": "agentrus.removeDoc",
          "when": "false"
        },
        {
          "command": "agentrus.revealDocsFolder",
          "when": "false"
        },
        {
          "command": "agentrus.configureInitiative",
          "when": "false"
        },
        {
          "command": "agentrus.configureAgent",
          "when": "false"
        },
        {
          "command": "agentrus.configureShell",
          "when": "false"
        },
        {
          "command": "agentrus.addAgent",
          "when": "false"
        },
        {
          "command": "agentrus.removeAgent",
          "when": "false"
        },
        {
          "command": "agentrus.renameShell",
          "when": "false"
        },
        {
          "command": "agentrus.addDefaultShells",
          "when": "false"
        },
        {
          "command": "agentrus.moveInitiativeUp",
          "when": "false"
        },
        {
          "command": "agentrus.moveInitiativeDown",
          "when": "false"
        },
        {
          "command": "agentrus.revealDoc",
          "when": "false"
        },
        {
          "command": "agentrus.deleteDocFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent\"R\"Us",
      "properties": {
        "agentrus.models.architect": {
          "type": "string",
          "default": "fable",
          "description": "Model alias used for new architect agents."
        },
        "agentrus.models.dev": {
          "type": "string",
          "default": "opus",
          "description": "Model alias used for new dev agents."
        },
        "agentrus.models.reviewer": {
          "type": "string",
          "default": "fable",
          "description": "Model alias used for new reviewer agents."
        },
        "agentrus.models.generic": {
          "type": "string",
          "default": "sonnet",
          "description": "Model alias used for new generic agents — the little helper for questions and odd jobs."
        },
        "agentrus.skills.architect": {
          "type": "string",
          "default": "",
          "description": "Skill new architect agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.skills.dev": {
          "type": "string",
          "default": "",
          "description": "Skill new dev agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.skills.reviewer": {
          "type": "string",
          "default": "",
          "description": "Skill new reviewer agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.skills.generic": {
          "type": "string",
          "default": "",
          "description": "Skill new generic agents invoke as the first message of every launch (the initiative's docs directory is passed as its argument). Empty for none."
        },
        "agentrus.defaultShells": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Shells every new initiative starts with, e.g. [\"dev\", \"logs\"]. They are listed in the tree but not opened until clicked. Use \"Add Default Shells\" on an existing initiative's Shells group to backfill."
        },
        "agentrus.terminalLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "enumDescriptions": [
            "Open terminals in the panel, alongside the other terminals.",
            "Open terminals as editor tabs, so they can be split and arranged like files."
          ],
          "default": "panel",
          "description": "Where Agent\"R\"Us opens terminals for agents and shells. Takes effect on the next terminal."
        },
        "agentrus.activityPollSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "How often to check the transcript of an open agent that has no hook state, to tell working from idle. 0 disables the fallback; hook-backed agents keep reporting either way."
        },
        "agentrus.worktreeRoot": {
          "type": "string",
          "default": "",
          "description": "Directory that holds initiative worktrees. Relative paths resolve against the repository root. Defaults to a sibling folder named '<repo>-worktrees'."
        },
        "agentrus.copyToWorktree": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env"
          ],
          "description": "Files copied from the repository into each newly created worktree, relative to the repo root — untracked config like .env does not travel with `git worktree add`. Prefix an entry with **/ to copy every file with that name found anywhere in the repo (outside .git and node_modules)."
        },
        "agentrus.branchPrefix": {
          "type": "string",
          "default": "initiative/",
          "description": "Prefix applied to the branch created for each initiative."
        },
        "agentrus.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to launch Claude Code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
